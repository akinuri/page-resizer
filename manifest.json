{
  "manifest_version": 3,
  "name": "Page Resizer",
  "version": "1.0.0",
  "description": "Center and constrain any page's width so full-width sites don't stretch across ultra-wide monitors.",
  "permissions": ["scripting", "activeTab"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Page Resizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
